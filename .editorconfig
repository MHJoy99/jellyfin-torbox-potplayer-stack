root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.psm1]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.psd1]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.cmd]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.py]
end_of_line = lf
indent_style = space
indent_size = 4

[*.js]
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
end_of_line = lf
indent_style = space
indent_size = 2
