# ==============================================================================
# Caddyfile for MediaServer Production Reverse Proxy
# ==============================================================================

{$DOMAIN_NAME:localhost} {
    # Automatic HTTPS via Let's Encrypt / ZeroSSL
    tls {$ACME_EMAIL:admin@example.com}

    # Compression & HTTP Protocols
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Jellyfin Web & API Proxy with WebSocket Support
    handle {
        reverse_proxy jellyfin:8096 {
            # Standard Proxy Buffering and Header Forwarding
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}

            # Extended Timeouts for Video Stream Buffering & Chunked Transfers
            transport http {
                response_header_timeout 600s
                read_timeout 600s
                write_timeout 600s
            }
        }
    }

    # Logging configuration
    log {
        output stdout
        format json
    }
}
