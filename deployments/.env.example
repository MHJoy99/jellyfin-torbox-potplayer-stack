# ==============================================================================
# MediaServer Containerized Stack Environment Configuration (.env)
# ==============================================================================

# Timezone & Regional Settings
TZ=Asia/Shanghai

# Host and Domain Configuration
DOMAIN_NAME=media.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# User / Group IDs for Container Permissions (Match host or root inside container)
PUID=1000
PGID=1000

# Directory Paths on Host (Windows host path or Linux WSL2 path)
# Note: For Windows host with Docker Desktop / WSL2 engine:
# Windows drive E:\MediaServer maps to /run/desktop/mnt/host/e/MediaServer or /mnt/e/MediaServer
HOST_JELLYFIN_CONFIG=E:/MediaServer/config/jellyfin
HOST_JELLYFIN_CACHE=E:/MediaServer/config/jellyfin-cache
HOST_RCLONE_VFS_CACHE=C:/Users/Administrator/.cache/rclone/vfs
HOST_MEDIA_ROOT=G:/
HOST_CADDY_DATA=E:/MediaServer/config/caddy/data
HOST_CADDY_CONFIG=E:/MediaServer/config/caddy/config

# NVIDIA GPU Configuration (NVIDIA Container Toolkit)
# Set to 'all' or GPU UUID (e.g. GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

# FlareSolverr Configuration
FLARESOLVERR_PORT=8191
FLARESOLVERR_LOG_LEVEL=info

# Watchtower Configuration
WATCHTOWER_CLEANUP=true
WATCHTOWER_POLL_INTERVAL=86400
WATCHTOWER_INCLUDE_STOPPED=false
WATCHTOWER_REVIVE_STOPPED=false

# Port Allocations
JELLYFIN_HTTP_PORT=8096
JELLYFIN_HTTPS_PORT=8920
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
