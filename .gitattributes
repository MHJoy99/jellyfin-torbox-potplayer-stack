# Line endings and diff behavior. PowerShell and batch files stay CRLF for
# native Windows execution; shell, Python, JavaScript, and Markdown stay LF.

* text=auto

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary and playlist artifacts: never normalize or diff as text.
*.png binary
*.jpg binary
*.ico binary
*.dpl binary

# Language statistics: playlist artifacts are not source code.
*.dpl linguist-vendored
season_playlist.dpl linguist-vendored
test_playlist.dpl linguist-vendored
