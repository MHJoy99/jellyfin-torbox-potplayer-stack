# Cloudflare Tunnel Configuration Template for Jellyfin Media Server
# Place the finalized file at: %USERPROFILE%\.cloudflared\config.yml or E:\MediaServer\config\cloudflared\config.yml
# Run via CLI: cloudflared tunnel --config E:\MediaServer\config\cloudflared\config.yml run <TUNNEL_UUID_OR_NAME>

tunnel: YOUR_TUNNEL_UUID_HERE
credentials-file: C:\Users\Administrator\.cloudflared\YOUR_TUNNEL_UUID_HERE.json

# Transport Protocol Optimization:
# - quic: UDP-based HTTP/3 transport (Low latency, head-of-line blocking elimination, superior for WAN media streaming)
# - http2: Fallback TCP-based multiplexed transport
protocol: quic

# Edge Transport & Connection Tuning
originRequest:
  # Upstream connect timeout
  connectTimeout: 30s
  # Keep-alive connection pooling to local Jellyfin instance
  keepAliveConnections: 100
  keepAliveTimeout: 90s
  # Disable TLS verification only if Jellyfin is bound to a self-signed HTTPS port
  noTLSVerify: false
  # Enable HTTP/2 multiplexing between cloudflared and upstream origin
  http2Origin: true
  # Upstream proxy headers
  proxyAddress: 127.0.0.1
  # Upstream TCP keepalive
  tcpKeepAlive: 30s

# Ingress Rules routing external traffic to internal services
ingress:
  # 1. Jellyfin Web Application & Streaming Ingress
  - hostname: jellyfin.yourdomain.com
    service: http://127.0.0.1:8096
    originRequest:
      connectTimeout: 15s
      noTLSVerify: false
      http2Origin: true
      tcpKeepAlive: 30s
      keepAliveTimeout: 90s

  # 2. Catch-all Rule (Required by Cloudflare Tunnel daemon - must be last)
  - service: http_status:404
